<div class="d-flex justify-content-between align-items-center my-2 container">
  <h2>出貨單明細</h2>
</div>

<div class="container">
  <div class="card">
    <div class="card-body">
      <ul>
        <li><strong>出貨門市：</strong>{{order.SHOP_ID}}</li>
        <li><strong>負責人員：</strong>{{order.USER}}</li>
        <li><strong>建立日期：</strong>{{order.INPUT_DATE}}</li>
      </ul>
      <ul>
        <li><strong>出貨單號：</strong>{{order.OUT_ID}}</li>
        <li><strong>核准人員：</strong>
          {{#if order.APP_USER}}
          <strong>{{order.APP_USER}}</strong>
          {{else}}
          <span class="text-secondary">單據未核准</span>
          {{/if}}
        </li>
        <li><strong>核准日期：</strong>
          {{#if order.APP_DATE}}
          <strong>{{order.APP_DATE}}</strong>
          {{else}}
          <span class="text-secondary">單據未核准</span>
          {{/if}}
        </li>
      </ul>
      <ul>
        <li><strong>出貨倉庫：</strong>{{order.SHOP_ID}}</li>
        <li><strong>收貨倉庫：</strong>{{order.TO_SHOP}}</li>
        <li><strong>資料筆數：</strong>{{order.detail_count}}</li>
      </ul>

      <ul>
        <li><strong>入庫單號：</strong>
          {{#if order.EXPORT_ID}}
          <strong>{{order.EXPORT_ID}}</strong>
          {{else}}
          <span class="text-secondary">門市未入庫</span>
          {{/if}}
        </li>
      </ul>
    </div>
  </div>

  <div class="d-flex my-2">
    <form action="/pos-wh/data/download/st-order-out"
          method="POST"
          id="st-order-download-form">
      <input type="text"
             name="OUT_ID"
             class="d-none"
             value="{{order.OUT_ID}}">
      <button type="submit"
              form="st-order-download-form"
              class="btn btn-primary me-2">匯出 出貨單</button>
    </form>

    <form action="/pos-wh/data/download/st-order-out-erp"
          method="POST"
          class="m-0">
      <input type="hidden"
             name="OUT_ID"
             value="{{order.OUT_ID}}">
      <button type="submit"
              class="btn btn-info">
        匯出 ERP匯入檔
      </button>
    </form>
  </div>

  <table class="table table-bordered align-middle table-hover mt-3"
         style="table-layout: fixed; width: 100%;">
    <thead class="bg-light"
           style="position: sticky; top: 108px; z-index: 1020;">
      <tr>
        <th style="width: 60px"
            class="text-center">#</th>
        <th style="width: 240px">商品類別</th>
        <th style="width: 300px">商品名稱</th>
        <th style="width: 120px;"
            class="text-center">數量</th>
        <th style="width: 120px;"
            class="text-center">單位</th>
        <th style="width: 190px;">備註</th>
      </tr>
    </thead>
    <tbody>
      {{#each order.PROD_DATA}}
      <tr>
        <td class="text-center">{{OUT_SNO}}</td>
        <td>{{DEP}}</td>
        <td>{{PROD_NAME}}</td>
        <td class="text-center">{{QUANTITY}}</td>
        <td class="text-center">{{UNIT}}</td>
        <td>{{MEMO1}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

</div>