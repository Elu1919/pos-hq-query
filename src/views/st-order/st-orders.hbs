<!-- ✅ 頁面標題與提示按鈕 -->

<div class="d-flex justify-content-between align-items-center my-2">
  <h2 class="mb-0">門市補撥單據查詢</h2>
  <button type="button"
          class="btn btn-warning"
          data-bs-toggle="modal"
          data-bs-target="#hint1">
    查看操作提示
  </button>
</div>

<!-- ✅ 操作提示 Modal -->
<div class="modal fade"
     id="hint1"
     tabindex="-1"
     aria-labelledby="hintLabel"
     aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold"
            id="hintLabel">操作提示</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="關閉"></button>
      </div>
      <div class="modal-body">
        <p>說明待更新</p>
        {{!-- <p><span class="fs-6 badge bg-warning text-dark">1</span> 輸入查詢條件，無輸入資料為全選</p>
        <p><span class="fs-6 badge bg-warning text-dark">2</span> 按下「Enter」或藍色「查詢」鍵，可進行資料篩選與查詢</p> --}}
        <p>－－－－－－－－－－－－－－－－－－－－－－－－－－－－－</p>
        <p><span class="fs-6 badge bg-info text-dark">注意</span> 安全設定關係，本系統只有在麻豆總部網域可以進行查詢</p>
      </div>
    </div>
  </div>
</div>

<!-- ✅ 固定頂部的控制列 -->
<div class="bg-light sticky-top py-3 container"
     style="top: 56px; z-index: 1030;">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <!-- 篩選表單 -->
    <form action="/st-order/order"
          method="POST"
          id="st-order-form">

      <div class="input-group input-group-sm mb-2"
           style="height: 35px;">
        <span class="input-group-text"
              style="height: 35px;">日期範圍</span>
        <input type="date"
               name="SALE_DATE_S"
               class="form-control"
               style="height: 35px; max-width:220px;"
               value="{{filterIn.SALE_DATE_S}}"
               aria-describedby="basic-addon1">
        <p class="me-2 ms-2 pt-1"
           style="height: 35px;"> ~ </p>
        <input type="date"
               name="SALE_DATE_E"
               class="form-control"
               style="height: 35px; max-width:220px;"
               value="{{filterIn.SALE_DATE_E}}"
               aria-describedby="basic-addon1">

        <span class="input-group-text"
              style="height: 35px;">補撥門市</span>
        {{#each shop}}
        <input class="btn-check"
               type="checkbox"
               name="SHOP_ID"
               id="{{this.SHOP_ID}}"
               value="{{this.SHOP_ID}}"
               {{#if
               this.isCheck}}checked{{/if}}>
        <label class="btn btn-outline-secondary"
               style="height: 35px; width:35px;"
               for="{{this.SHOP_ID}}"><span class="align-middle">{{this.SHOP_ID}}</span></label>
        {{/each}}

      </div>

      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex gap-2">
          <button type="submit"
                  form="st-order-form"
                  class="btn btn-primary">查詢</button>
        </div>
      </div>

    </form>
  </div>
</div>

<table class="table table-striped table-hover w-100 align-middle table-bordered container"
       style="font-size: 15px;">
  <thead class="table-dark align-middle text-center"
         style="position: sticky; top: 175px; z-index: 1020;">
    <tr>
      <th style="width: 70px;">申請門市</th>
      <th style="width: 120px;">建立時間</th>
      <th style="width: 70px;">申請人員</th>
      <th style="width: 70px;">資料數量</th>
      <th style="width: 140px;">單據備註</th>
      <th style="width: 120px;">撥補單 (申請單)</th>
      <th style="width: 120px;">出貨單</th>
      <th style="width: 100px;">匯出 撥補單</th>
      <th style="width: 200px;">匯出 出貨單</th>


    </tr>
  </thead>

  <tbody class="text-center">
    {{#each orders}}
    <tr>
      <td>{{SHOP_ID}}</td>
      <td>{{INPUT_DATE}}</td>
      <td>{{USER}}</td>
      <td>{{detail_count}}</td>
      <td>{{MEMO}}</td>
      <td>
        <strong><a href="/st-order/order/{{ORDER_ID}}"
             target="_blank"
             rel="noopener noreferrer"
             role="button">
            {{ORDER_ID}} <i class="fa-solid fa-arrow-up-right-from-square"
               style="color: rgb(6, 108, 189);"></i>
          </a></strong>
      </td>
      <td>
        {{#if EXPORT_ID}}
        <strong><a href="/st-order/order-out/{{EXPORT_ID}}"
             target="_blank"
             rel="noopener noreferrer"
             role="button">
            {{EXPORT_ID}} <i class="fa-solid fa-arrow-up-right-from-square"
               style="color: rgb(6, 108, 189);"></i>
          </a></strong>
        {{else}}
        <span class="text-secondary">單據未導出</span>
        {{/if}}
      </td>

      <td class="align-middle text-center">
        <form action="/pos/data/download/st-order"
              method="POST"
              class="m-0">
          <input type="hidden"
                 name="ORDER_ID"
                 value="{{ORDER_ID}}">
          <button type="submit"
                  class="btn btn-primary">列印用</button>
        </form>
      </td>

      <td class="align-middle text-center">
        <div class="d-flex justify-content-center gap-2">
          <form action="/pos/data/download/st-order-out"
                method="POST"
                class="m-0">
            <input type="hidden"
                   name="OUT_ID"
                   value="{{EXPORT_ID}}">
            <button type="submit"
                    class="btn {{#if EXPORT_ID}}btn-primary{{else}}btn-secondary{{/if}}"
                    {{#unless
                    EXPORT_ID}}disabled{{/unless}}>
              列印用
            </button>
          </form>
          <form action="/pos/data/download/st-order-out-erp"
                method="POST"
                class="m-0">
            <input type="hidden"
                   name="OUT_ID"
                   value="{{EXPORT_ID}}">
            <button type="submit"
                    class="btn {{#if EXPORT_ID}}btn-info{{else}}btn-secondary{{/if}}"
                    {{#unless
                    EXPORT_ID}}disabled{{/unless}}>
              ERP匯入
            </button>
          </form>
        </div>
      </td>
      {{/each}}
  </tbody>
</table>