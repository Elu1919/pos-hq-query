<div class="d-flex justify-content-between align-items-center my-2 container">
  <h2>補撥單明細</h2>
</div>

<div class="container">
  <div class="card">
    <div class="card-body">
      <ul>
        <li><strong>申請門市：</strong>{{order.SHOP_ID}}</li>
        <li><strong>申請人員：</strong>{{order.USER}}</li>
        <li><strong>申請日期：</strong>{{order.INPUT_DATE}}</li>
      </ul>
      <ul>
        <li><strong>申請單號：</strong>{{order.ORDER_ID}}</li>
        <li><strong>申請倉庫：</strong>{{order.STK_ID}}</li>
        <li><strong>出貨倉庫：</strong>{{order.OUT_SHOP}}</li>
        <li><strong>資料筆數：</strong>{{order.detail_count}}</li>
      </ul>
      <ul>
        <li><strong>出貨單號：</strong>
          {{#if order.EXPORT_ID}}
          <strong><a href="/st-order/order-out/{{order.EXPORT_ID}}"
               target="_blank"
               rel="noopener noreferrer"
               role="button">
              {{order.EXPORT_ID}}
              <i class="fa-solid fa-arrow-up-right-from-square"
                 style="color: rgb(6, 108, 189);"></i>
            </a></strong>
          {{else}}
          <span class="text-secondary">單據未導出</span>
          {{/if}}
        </li>
      </ul>
    </div>
  </div>

  <form action="/pos-wh/data/download/st-order"
        class="my-2"
        method="POST"
        id="st-order-download-form">
    <input type="text"
           name="ORDER_ID"
           class="d-none"
           value="{{order.ORDER_ID}}">
    <button type="submit"
            form="st-order-download-form"
            class="btn btn-primary">匯出 撥補單</button>
  </form>

  <table class="table table-bordered align-middle table-hover mt-3"
         style="table-layout: fixed; width: 100%;">
    <thead class="bg-light"
           style="position: sticky; top: 108px; z-index: 1020;">
      <tr>
        <th style="width: 60px"
            class="text-center">#</th>
        <th style="width: 240px">商品類別</th>
        <th style="width: 300px">商品名稱</th>
        <th style="width: 120px;"
            class="text-center">數量</th>
        <th style="width: 120px;"
            class="text-center">單位</th>
        <th style="width: 190px;">備註</th>
      </tr>
    </thead>
    <tbody>
      {{#each order.PROD_DATA}}
      <tr>
        <td class="text-center">{{ORDER_SNO}}</td>
        <td>{{DEP}}</td>
        <td>{{PROD_NAME}}</td>
        <td class="text-center">{{QUANTITY}}</td>
        <td class="text-center">{{UNIT}}</td>
        <td>{{MEMO1}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

</div>