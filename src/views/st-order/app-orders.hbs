<!-- 標題與操作提示 -->
<div class="d-flex justify-content-between align-items-center mb-2 container">
  <h2>門市訂單列表</h2>
  <button type="button"
          class="btn btn-warning"
          data-bs-toggle="modal"
          data-bs-target="#hint1">查看操作提示</button>
</div>

<!-- 操作提示 Modal -->
<div class="modal fade"
     id="hint1"
     tabindex="-1"
     aria-labelledby="exampleModalLabel"
     aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">操作提示</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p><span class="badge bg-warning text-dark">1</span> 可由頁籤切換查看「待核准」「已核准」「已報廢」訂單</p>
        <p><span class="badge bg-warning text-dark">2</span> 輸入日期以查詢歷史訂單，預設顯示為7天內</p>
        <p><span class="badge bg-danger text-white">待核准</span> 點擊「查看」按鈕，進行訂單的「核准」或「作廢」</p>
        <p><span class="badge bg-success text-white">已核准</span> 可匯出條碼與訂單內容供列印</p>
        <p><span class="badge bg-secondary text-white">已作廢</span> 可查看已作廢的訂單紀錄</p>
      </div>
    </div>
  </div>
</div>

<!-- 篩選區塊（固定頂部） -->
<div class="bg-light sticky-top py-3 container"
     style="top: 56px; z-index: 1030;">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
    <ul class="nav nav-tabs">
      <li class="nav-item">
        <a class="nav-link {{#if (eq status '待核准' )}}active{{/if}}"
           aria-current="page"
           href="/st-order/app-order?status=待核准">待核准</a>
      </li>
      <li class="nav-item">
        <a class="nav-link {{#if (eq status '已核准' )}}active{{/if}}"
           href="/st-order/app-order?status=已核准">已核准</a>
      </li>
      <li class="nav-item">
        <a class="nav-link {{#if (eq status '已作廢' )}}active{{/if}}"
           href="/st-order/app-order?status=已作廢">已作廢</a>
      </li>
    </ul>
    <form method="GET"
          action="/st-order/app-order"
          class="d-flex gap-2 align-items-center">
      <div>
        <input type="date"
               name="startDate"
               class="form-control"
               value="{{startDate}}">
      </div>
      <div>
        <span> ~ </span>
      </div>
      <div>
        <input type="date"
               name="endDate"
               class="form-control"
               value="{{endDate}}">
      </div>
      <input type="hidden"
             name="status"
             value="{{status}}" />
      <button type="submit"
              class="btn btn-outline-primary">篩選</button>
    </form>
  </div>
</div>

<!-- 表格 -->
<table class="table text-center align-middle table-hover container">
  <thead>
    <tr class="bg-light"
        style="position: sticky; top: 124px; z-index: 1020;">
      <th>訂單送出</th>
      <th>更新時間</th>
      <th>門市</th>
      <th>訂購人</th>
      <th>品項數量</th>
      <th>狀態</th>
      {{#if (eq this.status '已核准')}}
      <th>匯出資料</th>
      {{else}}
      <th>操作</th>
      {{/if}}
    </tr>
  </thead>
  <tbody>
    {{#each orders}}
    <tr>
      <td>{{formatDate this.updatedAt}}</td>
      <td>{{formatDate this.createdAt}}</td>
      <td>{{this.shopId}}</td>
      <td>{{this.customerName}}</td>
      <td>{{this.itemCount}}</td>
      <td>
        {{#if (eq this.status '待核准')}}
        <span class="fs-6 badge bg-danger text-white">待核准</span>
        {{else if (eq this.status '已核准')}}
        <span class="fs-6 badge bg-success text-white">已核准</span>
        {{else if (eq this.status '已作廢')}}
        <span class="fs-6 badge bg-secondary text-white">已作廢</span>
        {{else}}
        <span class="fs-6 badge border border-secondary text-secondary">{{this.status}}</span>
        {{/if}}
      </td>
      <td class="d-flex justify-content-center gap-2 flex-wrap">
        <a href="/st-order/app-order/{{this._id}}"
           class="btn btn-sm btn-outline-primary">查看</a>
        {{#or this.status "已核准" "調整核准"}}
        <form action="/order/print-label/{{this._id}}"
              method="GET"
              target="_blank">
          <button type="submit"
                  class="btn btn-sm btn-primary">條碼</button>
        </form>
        <form method="GET"
              action="/order/{{this._id}}/pdf"
              target="_blank">
          <button type="submit"
                  class="btn btn-sm btn-outline-danger">
            <i class="bi bi-file-earmark-pdf"></i> 訂單資料
          </button>
        </form>
        {{/or}}
      </td>
    </tr>
    {{else}}
    <tr>
      <td colspan="7">沒有符合的訂單</td>
    </tr>
    {{/each}}
  </tbody>
</table>