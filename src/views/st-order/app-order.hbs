<div class="d-flex justify-content-between align-items-center mb-2 container">
  <h2>訂單內容</h2>
  <button type="button"
          class="btn btn-warning"
          data-bs-toggle="modal"
          data-bs-target="#hint1">查看操作提示</button>
</div>

<div class="container">
  <ul>
    <li><strong>訂購人：</strong>{{order.customerName}}</li>
    <li><strong>訂購時間：</strong>{{formatDate order.createdAt}}</li>
    <li><strong>項目數量：</strong>{{itemCount}}</li>
    <li><strong>狀態：</strong>{{order.status}}</li>
    {{#if order.reviewerId}}
    <li><strong>審核人員：</strong>{{order.reviewerId.EMP_NAME}}</li>
    <li><strong>審核時間：</strong>{{formatDate order.reviewedAt}}</li>
    {{/if}}
  </ul>
</div>

<!-- 操作提示 Modal -->
<div class="modal fade"
     id="hint1"
     tabindex="-1"
     aria-labelledby="hint1Label"
     aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold"
            id="hint1Label">操作提示</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="關閉"></button>
      </div>
      <div class="modal-body">
        <p><span class="badge bg-warning text-dark">核准/作廢</span> 透過上方按鈕進行「核准」與「作廢」</p>
        <p><span class="badge bg-warning text-dark">更改訂單-1</span> 告知人員調整處，然後作廢此訂單</p>
        <p><span class="badge bg-warning text-dark">更改訂單-2</span> 人員可從「歷史訂單」中找到目前訂單進行複製，到購物車進行調整</p>
        <p><span class="badge bg-warning text-dark">更改訂單-3</span> 修改完成重新送出訂單即可</p>
      </div>
    </div>
  </div>
</div>

<div style="position: sticky; top: 56px; z-index: 1020;"
     class="d-flex justify-content-end align-items-center flex-wrap gap-2 bg-light py-2 container">
  <a href="/order/approval?status={{order.status}}"
     class="btn btn-secondary me-2">返回</a>
  {{#or order.status '待核准' '調整中'}}
  <button type="button"
          class="btn btn-success"
          data-bs-toggle="modal"
          data-bs-target="#confirmApprove">核准</button>
  <a href="/order/approval/{{order._id}}/edit"
     class="btn btn-primary">修改</a>
  <button type="button"
          class="btn btn-danger"
          data-bs-toggle="modal"
          data-bs-target="#confirmCancel">作廢</button>
  {{/or}}
</div>

<!-- 核准確認 Modal -->
<div class="modal fade"
     id="confirmApprove"
     tabindex="-1"
     aria-labelledby="confirmApproveLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/order/approval/{{order._id}}/approve"
            method="POST">
        <div class="modal-header">
          <h5 class="modal-title"
              id="confirmApproveLabel">確定要核准此訂單嗎？</h5>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label="關閉"></button>
        </div>
        <div class="modal-footer">
          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">取消</button>
          <button type="submit"
                  class="btn btn-success">確定核准</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 作廢確認 Modal -->
<div class="modal fade"
     id="confirmCancel"
     tabindex="-1"
     aria-labelledby="confirmCancelLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form action="/order/approval/{{order._id}}/cancel"
            method="POST">
        <div class="modal-header">
          <h5 class="modal-title"
              id="confirmCancelLabel"> 確定要作廢此訂單嗎？</h5>
          <button type="button"
                  class="btn-close"
                  data-bs-dismiss="modal"
                  aria-label="關閉"></button>
        </div>
        <div class="modal-footer">
          <button type="button"
                  class="btn btn-secondary"
                  data-bs-dismiss="modal">取消</button>
          <button type="submit"
                  class="btn btn-danger">確定作廢</button>
        </div>
      </form>
    </div>
  </div>
</div>

<table class="table table-bordered align-middle table-hover container"
       style="table-layout: fixed; width: 100%;">
  <thead class="bg-light"
         style="position: sticky; top: 108px; z-index: 1020;">
    <tr>
      <th style="width: 260px">類別</th>
      <th style="width: 300px">品項</th>
      <th style="width: 120px; min-width: 70px; ">數量</th>
      <th style="width: 120px;min-width:90px">單位</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    {{#each order.items}}
    <tr>
      <td>{{DEP_ID}}</td>
      <td>{{PROD_NAME2}}</td>
      <td>{{quantity}}</td>
      <td>{{unit}}</td>
      <td></td>
    </tr>
    {{/each}}
  </tbody>
</table>