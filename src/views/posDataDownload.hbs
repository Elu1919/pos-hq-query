<!-- ✅ 頁面標題與提示按鈕 -->

<div class="d-flex justify-content-between align-items-center mb-2">
    <h2 class="my-3">POS資料下載</h2>
    <button type="button"
            class="btn btn-warning"
            data-bs-toggle="modal"
            data-bs-target="#hint1">
        查看操作提示
    </button>
</div>

<!-- Modal -->
<!-- 操作提示 -->
<div class="modal fade"
     id="hint1"
     tabindex="-1"
     aria-labelledby="hintLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold"
                    id="hintLabel">操作提示 (點開按鈕看說明)</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="關閉"></button>
            </div>
            <div class="modal-body">
                <p>
                    <button class="btn btn-success"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#ifo-sale"
                            aria-expanded="false"
                            aria-controls="ifo-sale">
                        銷售資料 (匯入ERP) ▼
                    </button>
                </p>
                <div class="collapse mb-3"
                     id="ifo-sale">
                    <div class="card card-body">
                        <p><span class="fs-6 badge bg-secondary">1</span> 請選擇 [日期範圍]，無輸入則只抓當天資料</p>
                        <p><span class="fs-6 badge bg-secondary">2</span> 請選擇 [銷售門市]，無輸入則抓取全部門市資料</p>
                        <p><span class="fs-6 badge bg-secondary">3</span> 請選擇 [單據類型]，無輸入則抓取全部單據資料</p>
                        <p><span class="fs-6 badge bg-secondary">4</span> 選擇完畢後，按下按鈕［下載］，即可下載ERP匯入檔案
                        </p>
                    </div>
                </div>

                <p>
                    <button class="btn btn-success"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#ifo-transfer"
                            aria-expanded="false"
                            aria-controls="ifo-transfer">
                        調撥出庫、供應商進退貨、總部進退貨 (匯入ERP) ▼
                    </button>
                </p>
                <div class="collapse mb-3"
                     id="ifo-transfer">
                    <div class="card card-body">
                        <p><span class="fs-6 badge bg-secondary">1</span> 請選擇 [日期範圍]，無輸入則只抓當天資料</p>
                        <p><span class="fs-6 badge bg-secondary">2</span> 請選擇 [出庫門市]，無輸入則抓取全部門市資料</p>
                        <p><span class="fs-6 badge bg-secondary">3</span> 請選擇 [資料表]，無輸入則抓取全部單據資料</p>
                        <p><span class="fs-6 badge bg-secondary">4</span> 選擇完畢後，按下按鈕［下載］，即可下載ERP匯入檔案
                        </p>
                        <p class="text-danger fs-5 fw-bold mb-1 mt-4">資料抓取規則說明：</p>
                        <ol class="list-group list-group-flush list-group-numbered">
                            <li class="list-group-item">只抓取「核准」資料</li>
                            <li class="list-group-item">不抓取以下門市資料：總部(A)、測試店(TEST01)</li>
                            <li class="list-group-item">為對應ERP調撥規則，需強制門市使用[匯入]功能進行調撥入庫</br>　若調入門市未使用[匯入]功能入庫，將不會抓取到檔案內
                            </li>
                            <li class="list-group-item">可透過 <span class="fs-6 badge bg-warning text-dark">調撥未抓取</span>
                                按鈕，查看「調撥入庫」與「調撥出庫」沒有被抓取到的問題單據
                            </li>
                        </ol>
                        <p class="text-danger fs-5 fw-bold mt-4">功能 <span
                                  class="fs-6 badge bg-warning text-dark">調撥未抓取</span> 操作說明</p>
                        <ol class="list-group list-group-flush list-group-numbered">
                            <li class="list-group-item">請選擇 [日期範圍]，無輸入則只抓當天資料</li>
                            <li class="list-group-item">請選擇 [出庫門市]，無輸入則抓取全部門市資料</li>
                            <li class="list-group-item">選擇完畢後，按下按鈕［問題單據］，即可查看資料</li>
                        </ol>
                        <p class="fs-6 fw-bold mb-1 mt-2">未抓取說明：</p>
                        <ol class="list-group list-group-flush">
                            <li class="list-group-item"><span class="badge bg-secondary">0101</span> 調入門市不可為 A 或
                                TEST01</li>
                            <li class="list-group-item"><span class="badge bg-secondary">0102</span>
                                匯入門市，未使用[匯入]功能進行調撥入庫</li>
                            <li class="list-group-item"><span class="badge bg-secondary">0201</span> 調出門市不可為 A 或 TEST01
                            </li>
                            <li class="list-group-item"><span class="badge bg-secondary">0202</span> 未使用[匯入]功能進行調撥入庫
                            </li>
                            <li class="list-group-item"><span class="badge bg-secondary">9801</span> 單據不是「核准」狀態</li>
                            <li class="list-group-item"><span class="badge bg-secondary">9901</span> 總部key單、不納入表內</li>
                            <li class="list-group-item"><span class="badge bg-secondary">9902</span> 測試店key單、不納入表內
                            </li>
                        </ol>
                    </div>
                </div>

                <p>
                    <button class="btn btn-success"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#ifo-material"
                            aria-expanded="false"
                            aria-controls="ifo-material">
                        領用檔 (匯入ERP) ▼
                    </button>
                </p>
                <div class="collapse mb-3"
                     id="ifo-material">
                    <div class="card card-body">
                        <p><span class="fs-6 badge bg-secondary">1</span> 請選擇 [日期範圍]，無輸入則只抓當天資料</p>
                        <p><span class="fs-6 badge bg-secondary">2</span> 請選擇 [領用門市]，無輸入則抓取全部門市資料</p>
                        <p><span class="fs-6 badge bg-secondary">3</span> 選擇完畢後，按下按鈕［下載］，即可下載ERP匯入檔案
                        </p>
                    </div>
                </div>


                <hr>
                <p><span class="fs-6 badge bg-info text-dark">注意</span> 建議最多抓取1年資料 (時間範圍越長、需更多時間彙整資料)</p>
                <p><span class="fs-6 badge bg-info text-dark">注意</span> 安全設定關係，本系統只有在麻豆總部網域可以進行查詢</p>
            </div>
        </div>
    </div>
</div>

<!-- 調撥問題單據 -->
<div class="modal fade"
     id="no-transfer-modal"
     tabindex="-1"
     aria-labelledby="ModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">調撥資料表未抓取單據</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body"
                 id="no-transfer-content">
                <!-- 回傳資料 -->

            </div>
        </div>
    </div>
</div>

<!-- 調撥出庫，入庫「匯入」狀態 -->
<div class="modal fade"
     id="inModal"
     tabindex="-1"
     aria-labelledby="ModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">調撥出庫，入庫「匯入」狀態</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body"
                 id="inContent">
                <!-- 回傳資料 -->
            </div>
        </div>
    </div>
</div>


<!-- 下載區 -->
<!-- 銷售資料 -->
<div class="card mb-4">
    <h5 class="card-header bg-dark text-light fw-bold">銷售資料 (匯入ERP)</h5>

    <div class="card-body">
        <form action="/pos/data/download/sale"
              method="POST"
              class="d-flex justify-content-between"
              id="sale-form">

            <div class="input-group mb-2">
                <span class="input-group-text fw-bold">日期範圍</span>
                <input type="date"
                       name="SALE_DATE_S"
                       class="form-control"
                       style="max-width:220px;"
                       aria-describedby="basic-addon1">
                <p class="me-2 ms-2 pt-1"> ~ </p>
                <input type="date"
                       name="SALE_DATE_E"
                       class="form-control"
                       style="max-width:220px;"
                       aria-describedby="basic-addon1">

                <span class="input-group-text fw-bold">銷售門市</span>
                {{#each shop}}
                <input class="btn-check"
                       type="checkbox"
                       name="SHOP_ID"
                       id="sale-{{this.SHOP_ID}}"
                       value="{{this.SHOP_ID}}">
                <label class="btn btn-outline-secondary"
                       style="width: 45px;"
                       for="sale-{{this.SHOP_ID}}"><span class="align-middle">{{this.SHOP_ID}}</span></label>
                {{/each}}

                <span class="input-group-text fw-bold">單據類型</span>
                {{#each saleType}}
                <input class="btn-check"
                       type="checkbox"
                       name="TYPE"
                       id="{{this.TYPE_ID}}"
                       value="{{this.TYPE_ID}}">
                <label class="btn btn-outline-secondary"
                       for="{{this.TYPE_ID}}"><span class="align-middle">{{this.TYPE_NAME}}</span></label>
                {{/each}}

            </div>

            <button type="submit"
                    form="sale-form"
                    class="btn btn-primary fw-bold"
                    style="width: 100px;">下載 <i class="fa-regular fa-circle-down"
                   style="color: rgb(255, 255, 255);"></i></button>

        </form>

    </div>
</div>

<!-- 調撥出庫、供應商進貨、供應商退貨、總部進貨、總部退貨 -->
<div class="card mb-4">
    <h5 class="card-header bg-dark text-light fw-bold">調撥出庫、供應商進退貨、總部進退貨 (匯入ERP)</h5>

    <div class="card-body">
        <form action="/pos/data/download/transfer"
              method="POST"
              class="d-flex justify-content-between"
              id="transfer-form">

            <div class="input-group mb-2">
                <span class="input-group-text fw-bold">日期範圍</span>
                <input type="date"
                       name="SALE_DATE_S"
                       class="form-control"
                       style="max-width:220px;"
                       aria-describedby="basic-addon1">
                <p class="me-2 ms-2 pt-1"> ~ </p>
                <input type="date"
                       name="SALE_DATE_E"
                       class="form-control"
                       style="max-width:220px;"
                       aria-describedby="basic-addon1">

                <span class="input-group-text fw-bold">出庫門市</span>
                {{#each shop}}
                <input class="btn-check"
                       type="checkbox"
                       name="SHOP_ID"
                       id="transfer-{{this.SHOP_ID}}"
                       value="{{this.SHOP_ID}}">
                <label class="btn btn-outline-secondary"
                       style="width: 45px;"
                       for="transfer-{{this.SHOP_ID}}"><span class="align-middle">{{this.SHOP_ID}}</span></label>
                {{/each}}

                <span class="input-group-text fw-bold">資料表</span>
                <input class="btn-check"
                       type="checkbox"
                       name="TABLE"
                       id="OUT"
                       value="OUT">
                <label class="btn btn-outline-secondary"
                       for="OUT"><span class="align-middle">調撥出庫</span></label>
                <input class="btn-check"
                       type="checkbox"
                       name="TABLE"
                       id="TAKEIN"
                       value="TAKEIN">
                <label class="btn btn-outline-secondary"
                       for="TAKEIN"><span class="align-middle">供應商進貨</span></label>
                <input class="btn-check"
                       type="checkbox"
                       name="TABLE"
                       id="TAKEOUT"
                       value="TAKEOUT">
                <label class="btn btn-outline-secondary"
                       for="TAKEOUT"><span class="align-middle">供應商退貨</span></label>
                <input class="btn-check"
                       type="checkbox"
                       name="TABLE"
                       id="IN"
                       value="IN">
                <label class="btn btn-outline-secondary"
                       for="IN"><span class="align-middle">總部進貨</span></label>
                <input class="btn-check"
                       type="checkbox"
                       name="TABLE"
                       id="SEND_BACK"
                       value="SEND_BACK">
                <label class="btn btn-outline-secondary"
                       for="SEND_BACK"><span class="align-middle">總部退貨</span></label>

            </div>

            <div class="d-flex">
                <button id="no-transfer-btn"
                        style="width: 120px;"
                        class="btn btn-warning mx-2">調撥未抓取</button>

                <button type="submit"
                        form="transfer-form"
                        class="btn btn-primary fw-bold"
                        style="width: 100px;">下載 <i class="fa-regular fa-circle-down"
                       style="color: rgb(255, 255, 255);"></i></button>

            </div>


        </form>

    </div>
</div>

<!-- 領用 -->
<div class="card mb-4">
    <h5 class="card-header bg-dark text-light fw-bold">領用檔 (匯入ERP)</h5>

    <div class="card-body">
        <form action="/pos/data/download/material"
              method="POST"
              class="d-flex justify-content-between"
              id="material-form">

            <div class="input-group mb-2">
                <span class="input-group-text fw-bold">日期範圍</span>
                <input type="date"
                       name="SALE_DATE_S"
                       class="form-control"
                       style="max-width:220px;"
                       value="{{filterIn.SALE_DATE_S}}"
                       aria-describedby="basic-addon1">
                <p class="me-2 ms-2 pt-1"> ~ </p>
                <input type="date"
                       name="SALE_DATE_E"
                       class="form-control"
                       style="max-width:220px;"
                       value="{{filterIn.SALE_DATE_E}}"
                       aria-describedby="basic-addon1">

                <span class="input-group-text fw-bold">領用門市</span>
                {{#each shop}}
                <input class="btn-check"
                       type="checkbox"
                       name="SHOP_ID"
                       id="material-{{this.SHOP_ID}}"
                       value="{{this.SHOP_ID}}"
                       {{#if
                       this.isCheck}}checked{{/if}}>
                <label class="btn btn-outline-secondary"
                       style="width: 45px;"
                       for="material-{{this.SHOP_ID}}"><span class="align-middle">{{this.SHOP_ID}}</span></label>
                {{/each}}

            </div>

            <button type="submit"
                    form="material-form"
                    class="btn btn-primary fw-bold"
                    style="width: 100px;">下載 <i class="fa-regular fa-circle-down"
                   style="color: rgb(255, 255, 255);"></i></button>

        </form>

    </div>
</div>

<script src="/js/posDataDownload.js"></script>