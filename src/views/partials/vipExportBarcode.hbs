<div class="modal fade"
     id="exportBarcodeModal"
     tabindex="-1"
     aria-labelledby="hintLabel"
     data-bs-backdrop="static"
     aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold">請勾選欲列印貴賓</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body pt-0">
        {{#if vips.length}}
        <form method="POST"
              action="/vip/vip-data/export/barcode"
              id="vipExportBarcode-form">
          <div style="position: sticky; top: 0; z-index: 1040; background: #f8f9fa; padding-bottom: 5px;">
            <div class="d-flex justify-content-between align-items-center mb-2 pt-2 px-2 gap-3">
              <div class="d-flex gap-3">
                <span id="count-barcode"
                      class="fw-bold text-primary ms-2 mt-1"></span>
                <button type="button"
                        class="btn btn-sm btn-primary"
                        id="btnSelectAllBarcode">全選</button>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        id="btnUnselectAllBarcode">全部取消</button>
              </div>
              <button type="submit"
                      class="btn btn-sm btn-success">送出</button>
            </div>
          </div>

          <table class="table table-bordered table-hover align-middle"
                 style="table-layout: fixed; width: 100%;">
            <thead class="bg-light"
                   style="position: sticky; top: 50px; z-index: 1030;">
              <tr class="align-middle">
                <th class="text-center"
                    style="width: 60px;">勾選</th>
                <th class="col-3">貴賓名稱</th>
                <th style="width: 70px;">數量</th>
                <th style="width: 5px;"></th>
                <th class="text-center"
                    style="width: 60px;">勾選</th>
                <th class="col-3">貴賓名稱</th>
                <th style="width: 70px;">數量</th>
                <th style="width: 5px;"></th>
                <th class="text-center"
                    style="width: 60px;">勾選</th>
                <th class="col-3">貴賓名稱</th>
                <th style="width: 70px;">數量</th>
              </tr>
            </thead>

            <tbody id="vip-raw-data-barcode"
                   class="d-none">
              {{#each vips}}
              <tr>
                <td>{{VIP_ID}}</td>
                <td>{{NAME}}</td>
              </tr>
              {{/each}}
            </tbody>
            <tbody id="vip-table-body-barcode"></tbody>
          </table>
        </form>
        {{else}}
        <div class="alert alert-warning mt-3">請先查詢貴賓，資料會顯示於此</div>
        {{/if}}
      </div>
    </div>
  </div>
</div>