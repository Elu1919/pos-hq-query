<table id="prod-raw-data-qua"
       style="display: none;">
  <tbody>
    {{#each prods}}
    <tr>
      <td>{{PROD_ID}}</td>
      <td>{{PROD_NAME1}}</td>
    </tr>
    {{/each}}
  </tbody>
</table>


<div class="modal fade"
     id="prodQuantityModal"
     tabindex="-1"
     aria-labelledby="prodModalLabel"
     data-bs-backdrop="static"
     aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-xl">
    <div class="modal-content">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold"
            id="prodModalLabel">請勾選欲查詢商品</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="關閉"></button>
      </div>

      <div class="modal-body pt-0">
        {{#if prods.length}}
        <form method="POST"
              action="/prod/sale-data/qua"
              target="_blank"
              id="prodQua-form">

          <div style="position: sticky; top: 0; z-index: 1040; background: #f8f9fa; padding-bottom: 5px;">
            <div class="d-flex justify-content-between align-items-center mb-2 pt-2 px-2 gap-3">
              <div class="d-flex gap-3">
                <span id="count-qua"
                      class="fw-bold text-primary ms-2 mt-1">已勾選：0</span>

                <button type="button"
                        class="btn btn-sm btn-primary"
                        id="btnSelectAllProdQua">全選</button>
                <button type="button"
                        class="btn btn-sm btn-outline-danger"
                        id="btnUnselectAllProdQua">全部取消</button>
              </div>
              <button type="submit"
                      class="btn btn-sm btn-success">送出</button>
            </div>
          </div>

          <table class="table table-bordered table-hover align-middle"
                 style="table-layout: fixed; width: 100%;">
            <thead class="bg-light"
                   style="position: sticky; top: 50px; z-index: 1030;">
              <tr class="align-middle">
                <th class="text-center"
                    style="width: 60px;">勾選</th>
                <th class="col-4">商品名稱</th>
                <th style="width: 5px;"></th>
                <th class="text-center"
                    style="width: 60px;">勾選</th>
                <th class="col-4">商品名稱</th>
                <th style="width: 5px;"></th>
                <th class="text-center"
                    style="width: 60px;">勾選</th>
                <th class="col-4">商品名稱</th>
                <th style="width: 5px;"></th>
              </tr>
            </thead>
            <tbody id="prod-table-body-qua">
            </tbody>
          </table>
        </form>
        {{else}}
        <div class="alert alert-warning mt-3">查無商品資料，請先執行相關查詢。</div>
        {{/if}}
      </div>
    </div>
  </div>
</div>