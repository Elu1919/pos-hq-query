<!-- 數量總覽 -->
<div class="modal fade"
     id="vipAmountModal"
     tabindex="-1"
     aria-labelledby="ModalLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">數量總覽</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      <div class="modal-body"
           id="vipAmountContent">
        <!-- 回傳資料 -->
      </div>
    </div>
  </div>
</div>

<!-- ✅ 固定頂部的控制列 -->
<div class="bg-light sticky-top py-2"
     style="top: 56px; z-index: 1030;">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
    <!-- 篩選表單 -->
    <form action="/vip/vip-data"
          method="POST"
          id="vip-form">

      <div class="input-group input-group-sm mb-2 ">
        <span class="input-group-text">貴賓名稱</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipNameOptions"
               name="NAME"
               id="NAME"
               {{#if
               filterIn.NAME}}
               value="{{filterIn.NAME}}"
               {{/if}}>
        <datalist id="vipNameOptions">
          {{#each lists.vip}}
          <option value="{{this.NAME}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">貴賓編號</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipIdOptions"
               name="VIP_ID"
               id="VIP_ID"
               {{#if
               filterIn.VIP_ID}}
               value="{{filterIn.VIP_ID}}"
               {{/if}}>
        <datalist id="vipIdOptions">
          {{#each lists.vip}}
          <option value="{{this.VIP_ID}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">貴賓電話</span>
        <input class="form-control"
               style="max-width:120px;"
               name="TEL"
               id="TEL"
               {{#if
               filterIn.TEL}}
               value="{{filterIn.TEL}}"
               {{/if}}>

        <span class="input-group-text">聯絡人</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipLinkmanOptions"
               name="LINKMAN"
               id="LINKMAN"
               {{#if
               filterIn.LINKMAN}}
               value="{{filterIn.LINKMAN}}"
               {{/if}}>
        <datalist id="vipLinkmanOptions">
          {{#each lists.vip}}
          <option value="{{this.LINKMAN}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">貴賓群組</span>
        <select class="form-select"
                style="max-width:150px;"
                name="vipgrp_id"
                id="vipgrp_id">
          <option value=""
                  {{select
                  filterIn.vipgrp_id ""
                  }}>全部</option>
          {{#each lists.vipgrp}}
          <option value="{{this.vipgrp_id}}"
                  {{select
                  ../filterIn.vipgrp_id
                  this.vipgrp_id}}>
            {{this.vipgrp_name}}
          </option>
          {{/each}}
        </select>

        <span class="input-group-text">取號門市</span>
        <select class="form-select"
                style="max-width:120px;"
                name="APPLY_SHOP"
                id="APPLY_SHOP">
          <option value=""
                  {{select
                  filterIn.APPLY_SHOP ""
                  }}>全部</option>
          {{#each lists.shop}}
          <option value="{{this.SHOP_ID}}"
                  {{select
                  ../filterIn.APPLY_SHOP
                  this.SHOP_ID}}>
            {{this.SHOP_ID}}
          </option>
          {{/each}}
        </select>

      </div>

      <div class="input-group input-group-sm mb-2">

        <span class="input-group-text">公司名稱</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipCompanyOptions"
               name="COMPANY"
               id="COMPANY"
               {{#if
               filterIn.COMPANY}}
               value="{{filterIn.COMPANY}}"
               {{/if}}>
        <datalist id="vipCompanyOptions">
          {{#each lists.vip}}
          <option value="{{this.COMPANY}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">統一編號</span>
        <input class="form-control"
               style="max-width:120px;"
               name="vip_code"
               id="vip_code"
               {{#if
               filterIn.vip_code}}
               value="{{filterIn.vip_code}}"
               {{/if}}>

        <span class="input-group-text">地址</span>
        <input class="form-control"
               name="ADDRESS"
               id="ADDRESS"
               {{#if
               filterIn.ADDRESS}}
               value="{{filterIn.ADDRESS}}"
               {{/if}}>

        <span class="input-group-text">備註</span>
        <input class="form-control"
               name="MEMO"
               id="MEMO"
               {{#if
               filterIn.MEMO}}
               value="{{filterIn.MEMO}}"
               {{/if}}>

        <span class="input-group-text">是否停用</span>
        <select class="form-select"
                style="max-width:145px;"
                name="onlyDisabled"
                id="onlyDisabled">
          <option value="1"
                  {{select
                  filterIn.onlyDisabled "1"
                  }}>啟用</option>
          <option value="0"
                  {{select
                  filterIn.onlyDisabled "0"
                  }}>停用</option>
        </select>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2">
        <button type="submit"
                form="vip-form"
                class="btn btn-primary">查詢</button>
        <div class="d-flex gap-2">
          <button type="button"
                  id="exportA4Btn"
                  class="btn btn-success"
                  data-bs-toggle="modal"
                  data-bs-target="#exportA4Modal">
            匯出 A4條碼簿
          </button>
          <button type="button"
                  id="exportBarcodeBtn"
                  class="btn btn-success"
                  data-bs-toggle="modal"
                  data-bs-target="#exportBarcodeModal">
            匯出 標籤貼
          </button>
          <button id="vipAmountBtn"
                  class="btn btn-warning">數量總覽</button>
        </div>
      </div>

    </form>
  </div>
  <div class="container d-flex flex-wrap align-items-center gap-2">
    <nav aria-label="VIP 分頁">
      <ul class="pagination justify-content-start mt-3"
          id="vip-pagination"></ul>
    </nav>
  </div>
</div>

