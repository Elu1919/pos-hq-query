<!-- ✅ 頁面標題與提示按鈕 -->

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2 class="mb-0">貴賓資料查詢</h2>
  <button type="button"
          class="btn btn-warning"
          data-bs-toggle="modal"
          data-bs-target="#hint1">
    查看操作提示
  </button>
</div>

<!-- Modal -->
<!-- 操作提示 -->
<div class="modal fade"
     id="hint1"
     tabindex="-1"
     aria-labelledby="hintLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-dialog-scrollable modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold"
            id="hintLabel">操作提示</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="關閉"></button>
      </div>
      <div class="modal-body">
        <p><span class="fs-6 badge bg-primary">查詢</span></p>
        <p><span class="fs-6 badge bg-secondary">1</span> 輸入查詢條件，無輸入資料為全選</p>
        <p><span class="fs-6 badge bg-secondary">2</span> 按下「Enter」或藍色「查詢」鍵，可進行資料篩選與查詢</p>
        <hr>
        <p><span class="fs-6 badge bg-success">匯出 A4條碼簿</span></p>
        <p><span class="fs-6 badge bg-secondary">1</span> 先執行「查詢」</p>
        <p><span class="fs-6 badge bg-secondary">2</span> 按下按鈕［匯出 A4條碼簿］，會將查詢結果帶入</p>
        <p><span class="fs-6 badge bg-secondary">3</span> 可勾選欲列印的項目，預設「全選」，可透過按鈕「全部取消」</p>
        <p><span class="fs-6 badge bg-secondary">4</span> 編輯完畢後，按下按鈕［送出］，即可匯出 A4條碼簿</p>
        <p><span class="fs-6 badge bg-secondary">5</span> 按下送出後，需要等幾秒鐘讓報表生成，會在新分頁開啟</p>
        <hr>
        <p><span class="fs-6 badge bg-success">匯出 標籤貼</span></p>
        <p><span class="fs-6 badge bg-secondary">1</span> 先執行「查詢」</p>
        <p><span class="fs-6 badge bg-secondary">2</span> 按下按鈕［匯出 標籤貼］，會將查詢結果帶入</p>
        <p><span class="fs-6 badge bg-secondary">3</span> 可勾選欲列印的項目，預設「全選」，可透過按鈕「全部取消」</p>
        <p><span class="fs-6 badge bg-secondary">4</span> 可微調標籤貼輸出數量（不可為0）</p>
        <p><span class="fs-6 badge bg-secondary">5</span> 編輯完畢後，按下按鈕［送出］，即可匯出 條碼貼</p>
        <p><span class="fs-6 badge bg-secondary">6</span> 按下送出後，需要等幾秒鐘讓報表生成，會在新分頁開啟</p>
        <hr>
        <p><span class="fs-6 badge bg-warning text-dark">數量總覽</span></p>
        <p><span class="fs-6 badge bg-secondary">1</span> 可觀看總部已開貴賓額度：「已使用」「未使用」和「總數量」</p>
        <hr>
        <p><span class="fs-6 badge bg-info text-dark">注意</span> 匯出一次只能勾選900筆資料，避免資料處理過久</p>
        <p><span class="fs-6 badge bg-info text-dark">注意</span> 安全設定關係，本系統只有在麻豆總部網域可以進行查詢</p>
      </div>
    </div>
  </div>
</div>
<!-- 匯出檔案 -->
{{>vipExportA4}}
{{>vipExportBarcode}}

<!-- 數量總覽 -->
<div class="modal fade"
     id="vipAmountModal"
     tabindex="-1"
     aria-labelledby="ModalLabel"
     aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title fw-bold">數量總覽</h5>
        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      <div class="modal-body"
           id="vipAmountContent">
        <!-- 回傳資料 -->
      </div>
    </div>
  </div>
</div>

<!-- ✅ 固定頂部的控制列 -->
<div class="bg-light sticky-top py-2"
     style="top: 56px; z-index: 1030;">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
    <!-- 篩選表單 -->
    <form action="/vip/vip-data"
          method="POST"
          id="vip-form">

      <div class="input-group input-group-sm mb-2 ">
        <span class="input-group-text">貴賓名稱</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipNameOptions"
               name="NAME"
               id="NAME"
               {{#if
               filterIn.NAME}}
               value="{{filterIn.NAME}}"
               {{/if}}>
        <datalist id="vipNameOptions">
          {{#each lists.vip}}
          <option value="{{this.NAME}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">貴賓編號</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipIdOptions"
               name="VIP_ID"
               id="VIP_ID"
               {{#if
               filterIn.VIP_ID}}
               value="{{filterIn.VIP_ID}}"
               {{/if}}>
        <datalist id="vipIdOptions">
          {{#each lists.vip}}
          <option value="{{this.VIP_ID}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">貴賓電話</span>
        <input class="form-control"
               style="max-width:120px;"
               name="TEL"
               id="TEL"
               {{#if
               filterIn.TEL}}
               value="{{filterIn.TEL}}"
               {{/if}}>

        <span class="input-group-text">聯絡人</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipLinkmanOptions"
               name="LINKMAN"
               id="LINKMAN"
               {{#if
               filterIn.LINKMAN}}
               value="{{filterIn.LINKMAN}}"
               {{/if}}>
        <datalist id="vipLinkmanOptions">
          {{#each lists.vip}}
          <option value="{{this.LINKMAN}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">貴賓群組</span>
        <select class="form-select"
                style="max-width:150px;"
                name="vipgrp_id"
                id="vipgrp_id">
          <option value=""
                  {{select
                  filterIn.vipgrp_id ""
                  }}>全部</option>
          {{#each lists.vipgrp}}
          <option value="{{this.vipgrp_id}}"
                  {{select
                  ../filterIn.vipgrp_id
                  this.vipgrp_id}}>
            {{this.vipgrp_name}}
          </option>
          {{/each}}
        </select>

        <span class="input-group-text">取號門市</span>
        <select class="form-select"
                style="max-width:120px;"
                name="APPLY_SHOP"
                id="APPLY_SHOP">
          <option value=""
                  {{select
                  filterIn.APPLY_SHOP ""
                  }}>全部</option>
          {{#each lists.shop}}
          <option value="{{this.SHOP_ID}}"
                  {{select
                  ../filterIn.APPLY_SHOP
                  this.SHOP_ID}}>
            {{this.SHOP_ID}}
          </option>
          {{/each}}
        </select>

      </div>

      <div class="input-group input-group-sm mb-2">

        <span class="input-group-text">公司名稱</span>
        <input class="form-control"
               style="max-width:260px;"
               list="vipCompanyOptions"
               name="COMPANY"
               id="COMPANY"
               {{#if
               filterIn.COMPANY}}
               value="{{filterIn.COMPANY}}"
               {{/if}}>
        <datalist id="vipCompanyOptions">
          {{#each lists.vip}}
          <option value="{{this.COMPANY}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">統一編號</span>
        <input class="form-control"
               style="max-width:120px;"
               name="vip_code"
               id="vip_code"
               {{#if
               filterIn.vip_code}}
               value="{{filterIn.vip_code}}"
               {{/if}}>

        <span class="input-group-text">地址</span>
        <input class="form-control"
               name="ADDRESS"
               id="ADDRESS"
               {{#if
               filterIn.ADDRESS}}
               value="{{filterIn.ADDRESS}}"
               {{/if}}>

        <span class="input-group-text">備註</span>
        <input class="form-control"
               name="MEMO"
               id="MEMO"
               {{#if
               filterIn.MEMO}}
               value="{{filterIn.MEMO}}"
               {{/if}}>

        <span class="input-group-text">是否停用</span>
        <select class="form-select"
                style="max-width:145px;"
                name="onlyDisabled"
                id="onlyDisabled">
          <option value="1"
                  {{select
                  filterIn.onlyDisabled "1"
                  }}>啟用</option>
          <option value="0"
                  {{select
                  filterIn.onlyDisabled "0"
                  }}>停用</option>
        </select>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex gap-2">
          <button type="submit"
                  form="vip-form"
                  class="btn btn-primary">查詢</button>
          {{#if vips.length}}
          <span id="count-barcode"
                class="fw-bold ms-2 mt-2">共 {{vips.length}} 筆</span>
          {{/if}}
        </div>

        <div class="d-flex gap-2">
          <button type="button"
                  id="exportA4Btn"
                  class="btn btn-success"
                  data-bs-toggle="modal"
                  data-bs-target="#exportA4Modal">
            匯出 A4條碼簿
          </button>
          <button type="button"
                  id="exportBarcodeBtn"
                  class="btn btn-success"
                  data-bs-toggle="modal"
                  data-bs-target="#exportBarcodeModal">
            匯出 標籤貼
          </button>
          <button id="vipAmountBtn"
                  class="btn btn-warning">數量總覽</button>
        </div>
      </div>

    </form>
  </div>
  <div class="container d-flex flex-wrap align-items-center gap-2">
    <nav aria-label="VIP 分頁">
      <ul class="pagination justify-content-start mt-3"
          id="vip-pagination"></ul>
    </nav>
  </div>
</div>

<table class="table table-striped table-hover align-middle table-bordered w-75 m-auto"
       style="font-size: 15px;">
  <thead class="table-dark"
         style="position: sticky; top: 265px; z-index: 1020;">
    <tr>
      <th style="min-width: 60px;"
