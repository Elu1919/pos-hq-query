<style>
  /* 固定表頭：捲動時讓黑色標題列停留在上方 */
  .sticky-top {
    position: sticky;
    top: 56px;
    /* 如果有頂部導航欄，請根據導航欄高度調整此數值 */
    z-index: 1020;
  }

  /* 下拉選單內的 Checkbox 樣式優化 */
  .dropdown-menu .form-check {
    padding: 0.25rem 1.5rem;
    margin-bottom: 0;
    cursor: pointer;
  }

  .dropdown-menu .form-check:hover {
    background-color: #f8f9fa;
  }

  /* ✅ 列印優化：Ctrl+P 時會自動套用 */
  @media print {

    /* 隱藏不需要列印的元素（導覽列、篩選器、分頁、按鈕） */
    .no-print,
    .navbar,
    .sidebar,
    .card,
    .alert,
    .dropdown,
    .form-switch,
    #prod-pagination-client,
    .btn {
      display: none !important;
    }

    /* 強制表格佔滿寬度並調整字體 */
    .table {
      width: 100% !important;
      margin: 0 !important;
      font-size: 11pt;
    }

    /* 確保表格的深色背景色能印出來 */
    .table-dark {
      background-color: #212529 !important;
      color: #fff !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    @page {
      size: auto;
      margin: 1cm;
    }
  }
</style>

<!-- ✅ 頁面標題與提示按鈕 -->

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2 class="mb-0">商品庫存</h2>
</div>

<!-- ✅ 固定頂部的控制列 -->
<div class="bg-light sticky-top py-2"
     style="top: 56px; z-index: 1030;">

  <div class="alert alert-warning mt-3 w-75 mx-auto">如庫數量存顯示有問題，請先到POS總部後台進行「庫存重新計算」。　若還是無法解決，請聯繫系統負責人</div>

  <div class="card w-75 mx-auto mb-3 shadow-sm no-print">
    <div class="card-body py-2">
      <div class="d-flex align-items-center gap-4 flex-wrap">

        <div class="d-flex align-items-center">
          <span class="input-group-text me-2"
                style="height: 35px; border-radius: 5px;">顯示門市</span>

          <div class="btn-group"
               role="group"
               aria-label="門市篩選">
            {{#isRoles user.level "40"}}
            <input class="btn-check shop-toggle pe-none"
                   type="checkbox"
                   name="SHOP_ID"
                   id="chk-{{user.shopId}}"
                   value="{{user.shopId}}"
                   checked
                   tabindex="-1">
            <label class="btn btn-outline-secondary opacity-75 d-flex align-items-center justify-content-center"
                   style="height: 35px; width:45px; cursor: default;"
                   for="chk-{{user.shopId}}">
              <span>{{user.shopId}}</span>
            </label>
            {{else}}
            {{#each shopList}}
            <input class="btn-check shop-toggle"
                   type="checkbox"
                   name="SHOP_ID"
                   id="chk-{{this.SHOP_ID}}"
                   value="{{this.SHOP_ID}}"
                   checked>
            <label class="btn btn-outline-secondary d-flex align-items-center justify-content-center"
                   style="height: 35px; width:45px;"
                   for="chk-{{this.SHOP_ID}}">
              <span>{{this.SHOP_ID}}</span>
            </label>
            {{/each}}
            {{/isRoles}}
          </div>
        </div>

        <div class="form-check form-switch">
          <input class="form-check-input"
                 type="checkbox"
                 id="filterZeroStock"
                 checked>
          <label class="form-check-label fw-bold"
                 for="filterZeroStock">隱藏所有庫存為 0 的商品</label>
        </div>

        <div class="text-muted small">
          目前顯示筆數：<span id="visible-count">0</span>
        </div>
      </div>
    </div>
  </div>

  <table class="table table-striped table-hover align-middle table-bordered w-75 m-auto"
         id="main-inventory-table">
    <thead class="table-dark">
      <tr>
        <th>商品編號</th>
        <th>商品名稱</th>
        {{#each shopList}}
        <th class="text-center shop-col-header"
            data-shop-id="{{SHOP_ID}}">{{SHOP_NAME}}</th>
        {{/each}}
      </tr>
    </thead>
    <tbody id="prod-table-container">
      {{#each prodQuaList}}
      <tr class="inventory-row">
        <td>{{PROD_ID}}</td>
        <td>{{PROD_NAME1}}</td>
        {{#each ../shopList}}
        <td class="text-center shop-col {{#if (eq (lookup ../this SHOP_ID) 0)}}text-muted{{else}}fw-bold{{/if}}"
            data-shop-id="{{SHOP_ID}}"
            data-stock="{{lookup ../this SHOP_ID}}">
          {{lookup ../this SHOP_ID}}
        </td>
        {{/each}}
      </tr>
      {{/each}}
    </tbody>
  </table>

  <script src="/js/inventory.js"></script>