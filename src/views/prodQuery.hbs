<!-- ✅ 頁面標題與提示按鈕 -->

<div class="d-flex justify-content-between align-items-center mb-2">
  <h2 class="mb-0">商品資料查詢</h2>
  <button type="button"
          class="btn btn-warning"
          data-bs-toggle="modal"
          data-bs-target="#hint1">
    查看操作提示
  </button>
</div>

<!-- Modal -->
<!-- 操作提示 -->
{{>tips-modal/prodQuery}}

{{>prodQuaSearch}}
{{>prodExportA4}}
{{>prodExportBarcode}}

<!-- ✅ 固定頂部的控制列 -->
<div class="bg-light sticky-top py-2"
     style="top: 56px; z-index: 1030;">
  <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
    <!-- 篩選表單 -->
    <form action="/prod/prod-data"
          method="POST"
          id="prod-form">

      <div class="input-group input-group-sm mb-2 ">
        <span class="input-group-text">商品名稱</span>
        <input class="form-control"
               style="max-width:300px;"
               list="prodNameOptions"
               name="PROD_NAME"
               id="PROD_NAME"
               {{#if
               filterIn.PROD_NAME}}
               value="{{filterIn.PROD_NAME}}"
               {{/if}}>
        <datalist id="prodNameOptions">
          {{#each lists.prod}}
          <option value="{{this.PROD_NAME1}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">商品編號</span>
        <input class="form-control"
               style="max-width:160px;"
               list="prodIdOptions"
               name="PROD_ID"
               id="PROD_ID"
               {{#if
               filterIn.PROD_ID}}
               value="{{filterIn.PROD_ID}}"
               {{/if}}>
        <datalist id="prodIdOptions">
          {{#each lists.prod}}
          <option value="{{this.PROD_ID}}">
            {{/each}}
        </datalist>

        <span class="input-group-text">商品類別</span>
        <select class="form-select"
                style="max-width:150px;"
                name="DEP_ID"
                id="DEP_ID">
          <option value=""
                  {{select
                  filterIn.DEP_ID ""
                  }}>全部</option>
          {{#each lists.dep}}
          <option value="{{this.DEP_ID}}"
                  {{select
                  ../filterIn.DEP_ID
                  this.DEP_ID}}>
            {{this.DEP_NAME}}
          </option>
          {{/each}}
        </select>

        <span class="input-group-text">商品性質</span>
        <select class="form-select"
                style="max-width:150px;"
                name="PROD_KIND"
                id="PROD_KIND">
          <option value=""
                  {{select
                  filterIn.PROD_KIND ""
                  }}>全部</option>
          {{#each lists.kind}}
          <option value="{{this.PROD_ID}}"
                  {{select
                  ../filterIn.PROD_KIND
                  this.PROD_ID}}>
            {{this.PROD_NAME}}
          </option>
          {{/each}}
        </select>

        <span class="input-group-text">浮動價</span>
        <select class="form-select"
                style="max-width:90px;"
                name="isfloat"
                id="isfloat">
          <option value="-1"
                  {{select
                  filterIn.isfloat "-1"
                  }}>全部</option>
          <option value="1"
                  {{select
                  filterIn.isfloat "1"
                  }}>是</option>
          <option value="0"
                  {{select
                  filterIn.isfloat "0"
                  }}>否</option>
        </select>

        <span class="input-group-text">是否啟用</span>
        <select class="form-select"
                style="max-width:130px;"
                name="ENABLE"
                id="ENABLE">
          <option value="1"
                  {{select
                  filterIn.ENABLE "1"
                  }}>啟用</option>
          <option value="0"
                  {{select
                  filterIn.ENABLE "0"
                  }}>停用</option>
          <option value="2"
                  {{select
                  filterIn.ENABLE "2"
                  }}>POS可見</option>
          <option value="3"
                  {{select
                  filterIn.ENABLE "3"
                  }}>POS不可見</option>
          <option value="4"
                  {{select
                  filterIn.ENABLE "4"
                  }}>全部</option>
        </select>
      </div>

      <div class="d-flex justify-content-between align-items-center mb-2">
        <div class="d-flex gap-2">
          <button type="submit"
                  form="prod-form"
                  class="btn btn-primary">查詢</button>
          {{#if prods.length}}
          <span id="count-barcode"
                class="fw-bold ms-2 mt-2">共 {{prods.length}} 筆</span>
          {{/if}}
        </div>

        <div class="d-flex gap-2">
          <button type="button"
                  id="exportA4Btn"
                  class="btn btn-success"
                  data-bs-toggle="modal"
                  data-bs-target="#exportA4Modal">
            匯出 A4條碼簿
          </button>
          <button type="button"
                  id="exportBarcodeBtn"
                  class="btn btn-success"
                  data-bs-toggle="modal"
                  data-bs-target="#exportBarcodeModal">
            匯出 標籤貼
          </button>
          {{#authGte user.level 50}}
          <button type="button"
                  id="prodQuantityBtn"
                  class="btn btn-warning"
                  data-bs-toggle="modal"
                  data-bs-target="#prodQuantityModal">
            庫存查詢
          </button>
          {{/authGte}}
        </div>
      </div>

    </form>
  </div>
  <div class="container d-flex flex-wrap align-items-center gap-2">
    <nav aria-label="PROD 分頁">
      <ul class="pagination justify-content-start mt-3"
          id="prod-pagination-client"></ul>
    </nav>
  </div>
</div>

<table class="table table-striped table-hover align-middle table-bordered w-75 m-auto"
       style="font-size: 15px;">
  <thead class="table-dark"
         style="position: sticky; top: 225px; z-index: 1020;">
    <tr>
      <th style="width: 160px;">商品類別</th>
      <th style="width: 140px;">商品編號</th>
      <th style="width: 350px;">商品名稱</th>
      <th style="min-width: 80px;">門市價</th>
      <th style="min-width: 80px;">保養廠價</th>
      <th style="min-width: 80px;">機車行價</th>
      <th style="min-width: 45px;">單位</th>
      <th style="min-width: 45px;">稅率</th>
      <th style="width: 80px;"></th>
    </tr>
  </thead>

  <tbody id="prod-table-container">
    <!-- 顯示內容 -->
  </tbody>
</table>

<script> const prods = {{{ json prods }}} </script>
<script src="/js/pagination/Paginator.js"></script>
<script src="/js/pagination/pagination.js"></script>
<script src="/js/selectModal/genericSelectModal.js"></script>
<script src="/js/selectModal/queryInitializer.js"></script>
<script src="/js/prodQuery.js"></script>