  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --targets node18-win-x64 --output dist/app.exe"
  },
  "pkg": {
    "assets": [
      ".env",
      "public/**/*",
      "src/views/**/*",
      "node_modules/open/xdg-open"
