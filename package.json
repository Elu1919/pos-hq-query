{
  "name": "pos-hq-query",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "pkg . --targets node18-win-x64 --output ../wj-pos-query/app.exe && xcopy public ..\\wj-pos-query\\public /E /I /Y && xcopy src\\views ..\\wj-pos-query\\src\\views /E /I /Y"
  },
  "pkg": {
    "assets": [
      ".env",
      "public/**/*",
      "src/views/**/*",
      "node_modules/open/xdg-open"
    ],
    "scripts": [
      "server.js",
      "src/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "noBytecode": [
      "node_modules/is-wsl/**/*",
      "node_modules/is-docker/**/*",
      "node_modules/run-applescript/**/*",
      "node_modules/open/**/*",
      "node_modules/buffers/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bwip-js": "^4.8.0",
    "crypto": "^1.0.1",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "fontkit": "^2.0.4",
    "luxon": "^3.7.2",
    "mongoose": "^9.2.2",
    "mssql": "^11.0.1",
    "nodemon": "^3.1.10",
    "pdf-lib": "^1.17.1",
    "utc": "^0.1.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1",
    "rcedit": "^5.0.2"
  }
}