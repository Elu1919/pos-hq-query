    "scripts": [
      "server.js",
      "src/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "noBytecode": [
      "node_modules/is-wsl/**/*",
      "node_modules/is-docker/**/*",
      "node_modules/run-applescript/**/*",
      "node_modules/open/**/*",
      "node_modules/buffers/**/*"
    ]
  },
